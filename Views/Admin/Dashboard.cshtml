@model IEnumerable<RestaurantProject.Models.Order>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="dashboard-image-hero mb-5">
    <div class="dashboard-image-overlay">
        <div class="dashboard-hero-content">
            <span class="dashboard-welcome">Admin Overview</span>

            <h1>Mero Restaurant Dashboard</h1>

            <p>
                Manage menu items, track customer orders, monitor pending requests,
                and review restaurant sales from one professional dashboard.
            </p>

            <div class="dashboard-hero-actions">
                <a asp-controller="Orders" asp-action="AdminOrders" class="btn btn-primary">
                    View Orders
                </a>

                <a asp-controller="FoodItems" asp-action="Create" class="btn btn-light">
                    Add Food Item
                </a>
            </div>
        </div>

        <div class="dashboard-hero-side-card">
            <div class="side-card-icon">📊</div>
            <span>Today Overview</span>
            <h3>@ViewBag.PendingOrdersCount Pending</h3>
            <p>Orders waiting for action</p>
        </div>
    </div>
</section>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="dashboard-stat-card">
            <div class="stat-icon">📂</div>
            <span>Categories</span>
            <h3>@ViewBag.CategoriesCount</h3>
            <p>Menu sections</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dashboard-stat-card">
            <div class="stat-icon">🍽️</div>
            <span>Food Items</span>
            <h3>@ViewBag.FoodItemsCount</h3>
            <p>@ViewBag.AvailableFoodItemsCount available</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dashboard-stat-card">
            <div class="stat-icon">📦</div>
            <span>Orders</span>
            <h3>@ViewBag.OrdersCount</h3>
            <p>@ViewBag.PendingOrdersCount pending</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dashboard-stat-card">
            <div class="stat-icon">💰</div>
            <span>Total Sales</span>
            <h3 class="sales-number">@ViewBag.TotalSales.ToString("0.00")</h3>
            <p>EGP delivered orders</p>
        </div>
    </div>
</div>

<div class="dashboard-actions-grid mb-5">
    <a asp-controller="Categories" asp-action="Index" class="dashboard-action-card">
        <div>📂</div>
        <h4>Categories</h4>
        <p>Manage menu categories</p>
    </a>

    <a asp-controller="FoodItems" asp-action="Index" class="dashboard-action-card">
        <div>🍔</div>
        <h4>Food Items</h4>
        <p>Add and edit meals</p>
    </a>

    <a asp-controller="Orders" asp-action="AdminOrders" class="dashboard-action-card">
        <div>📦</div>
        <h4>Orders</h4>
        <p>Review customer orders</p>
    </a>
</div>

<div class="admin-page-header">
    <div>
        <span class="admin-label">Latest Activity</span>
        <h2>Latest Orders</h2>
        <p>Recently placed customer orders.</p>
    </div>

    <a asp-controller="Orders" asp-action="AdminOrders" class="btn btn-primary admin-create-btn">
        View All Orders
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h4>No orders yet</h4>
        <p>Latest orders will appear here when customers start ordering.</p>
    </div>
}
else
{
    <div class="admin-table-card">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end">Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>
                            <strong>@order.User?.FullName</strong>
                            <br />
                            <small class="text-muted">@order.User?.Email</small>
                        </td>

                        <td>@order.OrderDate.ToString("dd/MM/yyyy hh:mm tt")</td>

                        <td>
                            <strong class="price-text">@order.TotalAmount.ToString("0.00") EGP</strong>
                        </td>

                        <td>
                            <span class="order-status status-@order.Status.ToLower()">
                                @order.Status
                            </span>
                        </td>

                        <td class="text-end">
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-soft-info">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}