@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="restaurant-hero">
    <div class="hero-overlay-shape"></div>

    <div class="row align-items-center">
        <div class="col-lg-6">
            <span class="hero-badge">Fresh Food • Fast Delivery</span>

            <h1>
                Taste the Best Meals at
                <span>Mero Restaurant</span>
            </h1>

            <p>
                Explore a modern online restaurant experience. Browse our menu,
                choose your favorite meals, and place your order easily in just a few clicks.
            </p>

            <div class="hero-buttons">
                <a asp-controller="Menu" asp-action="Index" class="btn btn-primary btn-lg">
                    Explore Menu
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-outline-dark btn-lg">
                        My Orders
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-lg">
                        Create Account
                    </a>
                }
            </div>

            <div class="hero-mini-stats">
                <div>
                    <strong>Fresh</strong>
                    <span>Ingredients</span>
                </div>

                <div>
                    <strong>Fast</strong>
                    <span>Ordering</span>
                </div>

                <div>
                    <strong>Easy</strong>
                    <span>Tracking</span>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mt-5 mt-lg-0">
            <div class="hero-food-visual">
                <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=1000"
                     alt="Delicious food"
                     class="hero-main-food" />

                <div class="floating-card floating-card-top">
                    <span>⭐</span>
                    <div>
                        <strong>Top Rated</strong>
                        <small>Customer favorites</small>
                    </div>
                </div>

                <div class="floating-card floating-card-bottom">
                    <span>🔥</span>
                    <div>
                        <strong>Hot Meals</strong>
                        <small>Fresh every day</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="why-section mt-5">
    <div class="section-title text-center">
        <span>Why Choose Us?</span>
        <h2>We Serve More Than Just Food</h2>
        <p>
            Mero Restaurant combines fresh meals, simple ordering, and a smooth customer experience.
        </p>
    </div>

    <div class="row g-4 mt-3">
        <div class="col-md-3">
            <div class="why-card">
                <div class="why-icon">🥗</div>
                <h4>Fresh Ingredients</h4>
                <p>Meals prepared with fresh and high-quality ingredients.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="why-card">
                <div class="why-icon">⚡</div>
                <h4>Fast Ordering</h4>
                <p>Customers can order meals online quickly and easily.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="why-card">
                <div class="why-icon">📦</div>
                <h4>Order Tracking</h4>
                <p>Track order status from pending to delivered.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="why-card">
                <div class="why-icon">👨‍🍳</div>
                <h4>Admin Control</h4>
                <p>Admins can manage food items, categories, and orders.</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Categories -->
<section class="category-showcase mt-5">
    <div class="section-title text-center">
        <span>Menu Sections</span>
        <h2>Explore Our Categories</h2>
        <p>From tasty meals to drinks and desserts, everything is organized for easy browsing.</p>
    </div>

    <div class="row g-4 mt-3">
        <div class="col-md-3">
            <div class="category-showcase-card">
                <div>🍕</div>
                <h4>Pizza</h4>
                <p>Cheesy and hot meals.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="category-showcase-card">
                <div>🍔</div>
                <h4>Burgers</h4>
                <p>Juicy and delicious burgers.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="category-showcase-card">
                <div>🥤</div>
                <h4>Drinks</h4>
                <p>Cold and refreshing drinks.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="category-showcase-card">
                <div>🍰</div>
                <h4>Desserts</h4>
                <p>Sweet treats after meals.</p>
            </div>
        </div>
    </div>
</section>

<!-- Popular Meals -->
<section class="popular-section mt-5">
    <div class="section-title text-center">
        <span>Popular Picks</span>
        <h2>Customer Favorite Meals</h2>
        <p>Some examples of the meals customers can find in our restaurant menu.</p>
    </div>

    <div class="row g-4 mt-3">
        <div class="col-md-4">
            <div class="popular-card">
                <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=800" alt="Pizza" />
                <div class="popular-card-body">
                    <span class="category-pill">Pizza</span>
                    <h4>Cheese Pizza</h4>
                    <p>Hot pizza with melted cheese and delicious toppings.</p>
                    <div class="popular-footer">
                        <strong>180 EGP</strong>
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-sm btn-primary">View Menu</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="popular-card">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=800" alt="Burger" />
                <div class="popular-card-body">
                    <span class="category-pill">Burger</span>
                    <h4>Beef Burger</h4>
                    <p>Juicy burger served with fresh vegetables and sauce.</p>
                    <div class="popular-footer">
                        <strong>150 EGP</strong>
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-sm btn-primary">View Menu</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="popular-card">
                <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307?w=800" alt="Dessert" />
                <div class="popular-card-body">
                    <span class="category-pill">Dessert</span>
                    <h4>Sweet Dessert</h4>
                    <p>A perfect sweet choice to complete your meal.</p>
                    <div class="popular-footer">
                        <strong>90 EGP</strong>
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-sm btn-primary">View Menu</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="home-final-cta mt-5">
    <div>
        <span>Ready to order?</span>
        <h2>Discover your next favorite meal today.</h2>
        <p>
            Browse the menu, select your meal, and enjoy a simple online ordering experience.
        </p>
    </div>

    <a asp-controller="Menu" asp-action="Index" class="btn btn-light btn-lg">
        Go to Menu
    </a>
</section>