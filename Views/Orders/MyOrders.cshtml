@model IEnumerable<RestaurantProject.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="admin-page-header">
    <div>
        <span class="admin-label">Customer Area</span>
        <h2>My Orders</h2>
        <p>Track your previous and current food orders.</p>
    </div>

    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary admin-create-btn">
        Order More
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h4>No orders yet</h4>
        <p>You have not placed any orders yet. Start by exploring our menu.</p>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">View Menu</a>
    </div>
}
else
{
    <div class="orders-list">
        @foreach (var order in Model)
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div>
                        <span class="order-number">Order #@order.OrderId</span>
                        <h4>@order.OrderDate.ToString("dd/MM/yyyy hh:mm tt")</h4>
                    </div>

                    <span class="order-status status-@order.Status.ToLower()">
                        @order.Status
                    </span>
                </div>

                <div class="order-card-body">
                    <div class="order-info-item">
                        <span>Total</span>
                        <strong>@order.TotalAmount.ToString("0.00") EGP</strong>
                    </div>

                    <div class="order-info-item">
                        <span>Items</span>
                        <strong>
                            @foreach (var item in order.OrderItems)
                            {
                                <span class="order-food-line">@item.FoodItem?.Name × @item.Quantity</span>
                            }
                        </strong>
                    </div>

                    <div class="order-info-item">
                        <span>Address</span>
                        <strong>@order.DeliveryAddress</strong>
                    </div>
                </div>

                <div class="order-card-footer">
                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-soft-info">
                        View Details
                    </a>
                </div>
            </div>
        }
    </div>
}