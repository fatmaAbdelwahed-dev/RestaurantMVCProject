@model RestaurantProject.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="order-details-wrapper">
    <div class="form-header">
        <span class="admin-label">Order Information</span>
        <h2>Order Details</h2>
        <p>Full details for order #@Model.OrderId.</p>
    </div>

    <div class="order-details-card">
        <div class="order-details-main">
            <div class="order-details-top">
                <div>
                    <span class="order-number">Order #@Model.OrderId</span>
                    <h3>@Model.OrderDate.ToString("dd/MM/yyyy hh:mm tt")</h3>
                </div>

                <span class="order-status status-@Model.Status.ToLower()">
                    @Model.Status
                </span>
            </div>

            <div class="order-details-grid">
                <div>
                    <span>Total Amount</span>
                    <strong>@Model.TotalAmount.ToString("0.00") EGP</strong>
                </div>

                <div>
                    <span>Delivery Address</span>
                    <strong>@Model.DeliveryAddress</strong>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div>
                        <span>Notes</span>
                        <strong>@Model.Notes</strong>
                    </div>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div>
                        <span>Customer</span>
                        <strong>@Model.User?.FullName - @Model.User?.Email</strong>
                    </div>
                }
            </div>
        </div>

        <div class="order-items-section">
            <h4>Order Items</h4>

            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th>Food Item</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>SubTotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <strong>@item.FoodItem?.Name</strong>
                            </td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("0.00") EGP</td>
                            <td>
                                <strong class="price-text">@item.SubTotal.ToString("0.00") EGP</strong>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="form-actions mt-4">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="AdminOrders" class="btn btn-outline-dark">Back to Orders</a>
                }
                else
                {
                    <a asp-action="MyOrders" class="btn btn-outline-dark">Back to My Orders</a>
                }
            </div>
        </div>
    </div>
</div>