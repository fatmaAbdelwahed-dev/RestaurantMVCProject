<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mero Restaurant</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantProject.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="main-header">
        <nav class="navbar navbar-expand-lg custom-navbar">
            <div class="container">
                <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">🍽️</span>
                    <span class="brand-text">
                        Mero
                        <small>Restaurant</small>
                    </span>
                </a>

                <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto main-nav-links">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Menu" asp-action="Index">Menu</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="FoodItems" asp-action="Index">Food Items</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="AdminOrders">Orders</a>
                            </li>
                        }

                        @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="MyOrders">My Orders</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto auth-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-user-pill">
                                    <span class="user-dot"></span>
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                                    <button type="submit" class="btn btn-nav-logout">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link login-link" asp-controller="Account" asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-nav-register" asp-controller="Account" asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="footer-logo">
                        <span>🍽️</span>
                        <div>
                            <h5>Mero Restaurant</h5>
                            <p>Fresh meals, easy ordering, fast service.</p>
                        </div>
                    </div>
                </div>

                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Menu" asp-action="Index">Menu</a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                    {
                        <a asp-controller="Orders" asp-action="MyOrders">My Orders</a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                    }
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 Mero Restaurant. All rights reserved.</span>
                <span>Built with ASP.NET Core MVC</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>