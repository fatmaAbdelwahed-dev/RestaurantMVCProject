@model RestaurantProject.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="details-page-wrapper">
    <div class="form-header">
        <span class="admin-label danger-label">Delete Action</span>
        <h2>Delete Category</h2>
        <p>Please confirm before deleting this category.</p>
    </div>

    <div class="delete-card">
        <div class="delete-icon">⚠️</div>

        <h3>Are you sure?</h3>

        <p>
            You are about to delete the category
            <strong>@Model.Name</strong>.
            This action cannot be undone.
        </p>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="delete-info">
                @Model.Description
            </div>
        }

        <form asp-action="Delete" method="post" class="clean-form delete-form">
            <input type="hidden" asp-for="CategoryId" />

            <div class="form-actions justify-content-center">
                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index" class="btn btn-outline-dark">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>