@model RestaurantProject.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="details-page-wrapper">
    <div class="form-header">
        <span class="admin-label">Category Management</span>
        <h2>Category Details</h2>
        <p>View category information.</p>
    </div>

    <div class="info-card">
        <div class="info-icon">📂</div>

        <div class="info-content">
            <span class="info-label">Category Name</span>
            <h3>@Model.Name</h3>

            <span class="info-label mt-4">Description</span>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p>@Model.Description</p>
            }
            else
            {
                <p class="text-muted">No description provided.</p>
            }

            <div class="form-actions mt-4">
                <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary">
                    Edit Category
                </a>

                <a asp-action="Index" class="btn btn-outline-dark">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>